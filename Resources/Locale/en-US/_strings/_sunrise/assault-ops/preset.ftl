assaultops-title = Assault Team
assaultops-description = An assault team has targeted the station with the goal of seizing access to the secret Icarus weapon.
assaultops-welcome =
    You are a member of an elite assault team. Your mission is to attack { $station } and seize all GoldenEye access keys, which are located within the heads of the facility's command staff. Your leadership has equipped you with everything necessary to accomplish this task. 
    Good luck, Agent!
assaultops-opsmajor = [bold][color=crimson]Major Chaos Victory![/color][/bold]
assaultops-opsminor = [bold][color=crimson]Minor Chaos Victory![/color][/bold]
assaultops-hearty = [bold][color=crimson]Posthumous Victory![/color][/bold]
assaultops-stalemate = [bold][color=yellow]Stalemate![/color][/bold]
assaultops-crewmajor = [bold][color=green]Decisive Crew Victory![/color][/bold]
assaultops-cond-icarusactivated = Icarus was activated.
assaultops-cond-allopsdead = All members of the assault team have died.
assaultops-cond-someopssalive = Several members of the assault team have died.
assaultops-cond-allopsalive = All members of the assault team survived.
assaultops-list-start = The members of the assault team were:
assaultops-list-name = - [color=white]{ $name }[/color] ([color=gray]{ $user }[/color])
assaultops-not-enough-ready-players = Not enough players are ready! { $readyPlayersCount } out of the required { $minimumPlayers } players are ready. Unable to start Assault Team.
assaultops-not-enough-keys = Not enough keys! { $keys } of the required { $requiredKeys } players are Leaders. Cannot start the Assault Squad.
assaultops-no-one-ready = No one is ready! Cannot start the Assault Squad.
