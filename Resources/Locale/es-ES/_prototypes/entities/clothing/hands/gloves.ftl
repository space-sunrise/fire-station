    .desc = { ent-ClothingHandsGlovesNorthStar.desc }
ent-ClothingHandsGlovesForensic = Guantes Forenses
    .desc = No dejan fibras ni huellas. Si trabajas sin ellas, eres un DETECTIVE TERRIBLE.
ent-ClothingHandsGlovesJanitor = Guantes de goma
    .desc = ¡Guantes de goma de alta calidad que chirrian con ganas de limpiar!
ent-ClothingHandsKnuckleDusters = Nudillos de latón
