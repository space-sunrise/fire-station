ent-ShuttleGunBase = Cañón de escudo
    .desc = { "" }
ent-ShuttleGunSvalinnMachineGun = LSE-400b "Ametralladora Svalinn"
    .desc = Instalación básica de láser estacionario. Eficaz contra personal y aparatos eléctricos. Para disparar, utiliza baterías ordinarias y tiene una cadencia de fuego extremadamente alta.
    .suffix = No mapear
ent-ShuttleGunPerforator = Taladro de roca LSE-1200c
    .desc = Instalación avanzada de láseres estacionarios. ¡Destruye aparatos eléctricos y es extremadamente peligroso para la salud! Utiliza celdas de energía para disparar.
    .suffix = No mapear
ent-ShuttleGunFriendship = EXP-320g "Druzhba"
    .desc = Un pequeño lanzagranadas fijo que contiene 2 granadas.
    .suffix = No mapear
ent-ShuttleGunDuster = EXP-2100g "Duster"
    .desc = Un potente lanzagranadas fijo. Se necesita un cartucho para disparar.
    .suffix = No mapear
ent-ShuttleGunBullfrog = EXP-3600g "Toad"
    .desc = Potente lanzagranadas automático fijo de 40 mm. Se requiere un cartucho para disparar.
ent-ShuttleGunPirateCannon = Cañón de barco pirata
    .desc = ¡Kaboom!
ent-ShuttleGunKinetic = PTK-800 "Desmaterializador de Materia"
    .desc = Una torreta minera estacionaria de chatarra. Acumula cargas por sí sola y es extremadamente eficaz excavando asteroides.
    .suffix = No mapear
ent-ShuttleGunKineticOld = Desmaterializador xenomorfo
    .desc = Un cañón antiguo de barco que utiliza sistemas biomecánicos para almacenar y liberar energía. Único en su diseño, se ha vuelto obsoleto debido a su menor carga y velocidad de disparo en comparación con estructuras mecánicas.
ent-ShuttleGunLongbow = BAL-15 "Arco largo"
    .desc = Cañón automático estacionario de cañón largo. Se requiere un cargador de 15 mm para disparar.
    .suffix = No mapear
ent-ShuttleGunSquall = BAL-308 "Squall"
    .desc = Minigun fija de tres cañones. Para disparar, necesitas una caja con cinta .308.
    .suffix = No mapear
ent-ShuttleGunVympel = BAL-15-2 "Vympel"
    .desc = Cañón automático coaxial estacionario con alimentación por cinta. Para disparar, es necesario cargar manualmente la cinta de cartuchos de 15 mm.
    .suffix = No mapear
ent-ShuttleGunQuadling = BAL-15-4 "Quadling"
    .desc = LA POTENCIA DE UNO... ejem, cuatro cañones. Para disparar, tienes que cargar manualmente la cinta de cartuchos de 15mm.
    .suffix = No mapear
ent-ShuttleGunBeamstormMachineGun = LSE-800e "Beamstorm"
    .desc = Dispositivo láser estacionario avanzado. Tiene una cadencia de fuego extremadamente alta. Eficaz contra objetivos vivos y equipos electrónicos. Alimentado directamente desde la red de APC sin células de energía.
    .suffix = No mapear
ent-ShuttleGunTeslaOrion = TSL-200c "Orion"
    .desc = Una instalación de iones estacionaria de alta tecnología basada en el principio del motor experimental Tesla. Eficaz contra tecnología electrónica. Utiliza células de potencia para disparar un rayo de descarga o ión de Tesla.
    .suffix = No mapear
ent-ShuttleGunTeslaHyperion = TSL-300c "Hyperion"
    .desc = Una versión mejorada de la instalación iónica Orion, componentes reforzados y una consola para controlar la potencia de salida. Significativamente más eficaz contra equipos electrónicos. Utiliza células de potencia para disparar un rayo de descarga o ión de Tesla.
    .suffix = No mapear
