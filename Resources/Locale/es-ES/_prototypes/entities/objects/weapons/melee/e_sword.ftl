ent-BaseMeleeWeaponEnergy = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-EnergySword = Espada de Energía
    .desc = Una espada muy ruidosa y peligrosa con un rayo de plasma puro y concentrado. Corta objetos sin armadura como mantequilla.
ent-EnergyDaggerLoud = Daga de Energía
    .desc = No tan ruidosa ni peligrosa daga con un rayo de plasma puro y concentrado. Completamente privada de la capacidad de disfrazarse.
ent-EnergyDagger = Empuñadura
    .desc = Bolígrafo con tinta negra.
    .suffix = Daga de Energía
ent-EnergyDaggerBox = Estuche de la daga de energía
    .desc = Una pequeña caja que contiene una daga de energía. Una vez abierta, el paquete se desintegra, sin dejar pruebas.
    .suffix = Daga de Energía
ent-EnergyCutlass = Sable de Energía de Abordaje
    .desc = Armas de energía exótica.
ent-EnergySwordDouble = Espada de energía de doble hoja
    .desc = Los aprendices del mando del Sindicato decidieron que una hoja en una espada de energía no era suficiente. Podía guardarse en un bolsillo.
ent-HyperEutacticBlade = Hoja hipereutéctica
    .desc = Un arma supermasiva diseñada para cortar el propio tejido del espacio-tiempo, la hoja hipereutéctica forma dinámicamente rápidamente una nanoestructura cristalina hipereutéctica capaz de atravesar la mayoría de las formas conocidas de materia como un cuchillo caliente en mantequilla.
ent-CyborgEnergySwordDouble = { ent-EnergySwordDouble }
    .desc = Los becarios del Mando del Sindicato han decidido que una sola hoja en una espada de energía no es suficiente. Un diseño especial para los ciborgs del Sindicato.
    .suffix = Con una mano, para los Borg
ent-EnergyDaggerLoudBlue = { ent-EnergyDaggerLoud }
    .suffix = Azul
    .desc = { ent-EnergyDaggerLoud.desc }
