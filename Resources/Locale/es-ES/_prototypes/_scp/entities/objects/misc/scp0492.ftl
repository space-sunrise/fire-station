ent-RightHarmArm0492 = mala mano derecha
    .desc = Mano de acero oscuro. Cuando se reemplaza quirúrgicamente la mano derecha con este instrumento, el paciente puede golpear dolorosamente a los enemigos con él.
    .suffix = SCP-049-2
ent-LeftTubeArm0492 = mano izquierda tubular
    .desc = Tubo alargado de cobre. Al reemplazar quirúrgicamente el brazo izquierdo con este instrumento, el paciente puede expulsar los desechos de su cuerpo a través de un tubo.
    .suffix = SCP-049-2
ent-LeftSpringLeg0492 = pierna izquierda elástica
    .desc = Muelle grande plateado. Cuando la pierna izquierda se reemplaza quirúrgicamente con este instrumento, el paciente comienza a moverse más rápido.
    .suffix = SCP-049-2
ent-OrganFlashEyes0492 = ojos en tubos
    .desc = Dos tubos flexibles con matraces en los extremos. Al reemplazar quirúrgicamente los ojos con este instrumento, el paciente ya no sufre ceguera por los flashes.
    .suffix = SCP-049-2
ent-OrganTubeLungs0492 = bombeando pulmones
    .desc = La bomba está hecha de caucho negro bastante duro. Al reemplazar quirúrgicamente los pulmones con este instrumento, el paciente evita caídas y deja de resbalar.
    .suffix = SCP-049-2
ent-OrganLightingRodLiver0492 = hígado relámpago
    .desc = Parte compacta de cobre del pararrayos. Durante la cirugía de reemplazo de hígado, este instrumento no provocará descargas eléctricas al paciente.
    .suffix = SCP-049-2
