ghost-role-information-space-bear-name = Oso Espacial
ghost-role-information-space-bear-description = Te ruge el estómago y estas personas parecen muy apetitosas... ¡Qué banquete!
ghost-role-information-supplybot-name = Cargo Bot
ghost-role-information-supplybot-description = Entrega mercancías alrededor de la estación.
ghost-role-information-guardian-name = Guardian
