ghost-role-information-smile-name = Sonrisa de baba
ghost-role-information-smile-description = La criatura más adorable del mundo. ¡Sonríe, sonríe!
ghost-role-information-punpun-name = Poon Poon
ghost-role-information-punpun-description = Miembro honorario de la comunidad de monos, encargado del bar y ayudando a los camareros en todo lo que puede.
ghost-role-information-xeno-name = xeno
