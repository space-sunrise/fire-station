ghost-role-information-lost-challenge-commander-name = Comandante de permiso
ghost-role-information-lost-challenge-commander-description = Eres un comandante de otra nave espacial al que se le ha concedido permiso con uno de tus técnicos de carga.
ghost-role-information-lost-challenge-commander-rules =
    No eres hostil a la estación, haz lo que sea necesario para sobrevivir.
