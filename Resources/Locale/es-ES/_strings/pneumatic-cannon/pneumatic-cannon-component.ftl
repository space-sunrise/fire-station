### Loc for the pneumatic cannon.

pneumatic-cannon-component-itemslot-name = Cilindro de gas

## Shown when trying to fire, but no gas

pneumatic-cannon-component-fire-no-gas = { CAPITALIZE($cannon) } clic, pero el gas no sale.

## Shown when changing power.

pneumatic-cannon-component-change-power =
    { $power ->
        [High] Pones el limitador al máximo. No importa cómo salga, no demasiado...
        [Medium] Colocas el limitador en el centro.
       *[Low] Pones el limitador al mínimo.
    }

## Shown when being stunned by having the power too high.

pneumatic-cannon-component-power-stun = { CAPITALIZE($cannon) } te deja sin palabras.
