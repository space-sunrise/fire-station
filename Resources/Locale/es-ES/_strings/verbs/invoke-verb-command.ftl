### Localization used for the invoke verb command.


# Mostly help + error messages.

invoke-verb-command-description = Llama al verbo con un nombre de pila en la entidad, con la entidad jugador
invoke-verb-command-help = Uso: invokeverb <playerUid | "self"> <targetUid> <verbName | "interacción" | "activación" | "alternative">
invoke-verb-command-invalid-args = Invokeverb requiere 2 argumentos.
invoke-verb-command-invalid-player-uid = El UID del jugador no puede ser analizado, o el "self" no ha sido aprobado.
invoke-verb-command-invalid-target-uid = El uid objetivo no puede ser analizado.
invoke-verb-command-invalid-player-entity = El uid especificado para el jugador no corresponde a la entidad real.
invoke-verb-command-invalid-target-entity = El uid objetivo especificado no coincide con la entidad real.
invoke-verb-command-success = Llama al verbo '{ $verb }' en { $target } con { $player } como usuario.
invoke-verb-command-verb-not-found = No pude encontrar el verbo { $verb } en { $target }.
