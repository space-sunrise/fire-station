cmd-panicbunker-desc = Activa o desactiva el modo Silo, que impone restricciones más estrictas sobre quién puede conectarse al servidor.
cmd-panicbunker-help = Uso: panicbunker
panicbunker-command-enabled = El modo "Búnker" estaba activado.
panicbunker-command-disabled = El modo "Búnker" estaba desactivado.
cmd-panicbunker_disable_with_admins-desc = Activa o desactiva el modo Bunker cuando un administrador se conecta.
cmd-panicbunker_disable_with_admins-help = Uso: panicbunker_disable_with_admins
panicbunker-command-disable-with-admins-enabled = El modo "Búnker" se desactivará automáticamente con los administradores online.
panicbunker-command-disable-with-admins-disabled = El modo "Búnker" no se desactivará automáticamente con los administradores online.
cmd-panicbunker_enable_without_admins-desc = Activa o desactiva el modo Búnker cuando el último administrador se desconecta.
cmd-panicbunker_enable_without_admins-help = Uso: panicbunker_enable_without_admins
panicbunker-command-enable-without-admins-enabled = El modo "Búnker" se activará automáticamente si no hay administradores.
panicbunker-command-enable-without-admins-disabled = El modo silo no se activará automáticamente cuando no haya administradores presentes.
cmd-panicbunker_count_deadminned_admins-desc = Activa o desactiva la contabilidad de administradores privados de derechos cuando el modo "Búnker" se activa y desactiva automáticamente.
cmd-panicbunker_count_deadminned_admins-help = Uso: panicbunker_count_deadminned_admins
panicbunker-command-count-deadminned-admins-enabled = El modo "Bunker" tendrá en cuenta a los administradores revocados al activar y desactivar automáticamente.
panicbunker-command-count-deadminned-admins-disabled = El modo "Bunker" no tendrá en cuenta a los administradores revocados al activar y desactivar automáticamente.
cmd-panicbunker_show_reason-desc = Activa o desactiva la visualización del motivo del bloqueo de la conexión al usuario cuando el modo "Bunker" está activado.
cmd-panicbunker_show_reason-help = Uso: panicbunker_show_reason
panicbunker-command-show-reason-enabled = El modo búnker mostrará ahora la razón por la que los usuarios están bloqueando la conexión.
panicbunker-command-show-reason-disabled = El modo búnker ya no mostrará a los usuarios el motivo del bloqueo de la conexión.
cmd-panicbunker_min_account_age-desc = Establece o recibe la antigüedad mínima de la cuenta en minutos necesarios para conectarse cuando el modo "Búnker" está activado.
cmd-panicbunker_min_account_age-help = Uso: panicbunker_min_account_age <minutos>
panicbunker-command-min-account-age-is = La edad mínima de cuenta para el modo Búnker es de { $minutes } minutos.
panicbunker-command-min-account-age-set = La antigüedad mínima de la cuenta para el modo "Búnker" se ha establecido en { $minutes } minutos.
cmd-panicbunker_min_overall_minutes-desc = Establece o obtiene el tiempo mínimo de juego total en minutos necesarios para conectarse cuando el modo Búnker está activado.
cmd-panicbunker_min_overall_minutes-help = Uso: panicbunker_min_overall_minutes <minutos>
panicbunker-command-min-overall-minutes-is = El tiempo mínimo total de juego en el modo Búnker es de { $minutes } minutos.
panicbunker-command-min-overall-minutes-set = Establece el tiempo mínimo total de juego del modo Búnker a { $minutes } minutos.
