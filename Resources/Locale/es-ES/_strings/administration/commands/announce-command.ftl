cmd-announce-desc = Envía un anuncio dentro del juego con color y sonido personalizables.
cmd-announce-help = { $command } <mensaje> [remitente] <color> [sonido] - Envía un anuncio. El remitente predeterminado es CentCom, el color es dorado y el sonido es announce.ogg. El color debe tener el formato #RRGGBB.
# The default sender for the announcement
cmd-announce-sender = Mando Central
# Completion hints
cmd-announce-arg-message = <mensaje>
cmd-announce-arg-sender = [remitente]
cmd-announce-arg-color = <color>
cmd-announce-arg-sound = [sonido]
