objective-carp-rifts-title =
    Open { $count } { $count ->
        [one] Falla de la Carpa
        [few] Fallas de carpa
       *[other] Fallas de carpa
    }
objective-carp-rifts-description =
    Usa la interacción "Crear Grieta de Carpa" para abrir el { $count } { $count ->
        [one] Falla de la Carpa
        [few] Fallas de carpa
       *[other] Fallas de carpa
    } y evitar que sean destruidos. Si no abres la grieta tras 5 minutos, morirás.
