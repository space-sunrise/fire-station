# General
rule-restarting-in-seconds =
    Reinicia en { $seconds } { $seconds ->
        [one] Segundo
        [few] Segundos
       *[other] Segundos
    }.
rule-time-has-run-out = ¡Se acabó el tiempo!
# Respawning
rule-respawn-in-seconds =
    Renacimiento en { $second } { $second ->
        [one] Segundo
        [few] Segundos
       *[other] Segundos
    }...
