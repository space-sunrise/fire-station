execution-verb-name = Ejecutar
execution-verb-message = Usa tu arma para ejecutar a alguien.
suicide-verb-name = Suicidio
suicide-verb-message = Usa tu arma para llegar a fin de mes.

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# weapon (the weapon used for the execution)

execution-popup-gun-initial-internal = Apuntas el cañón { $weapon } a la cabeza de { $victim }.
execution-popup-gun-initial-external = { $attacker } dirige el cañón { $weapon } hacia la cabeza del { $victim }.
execution-popup-gun-complete-internal = ¡Disparas a { $victim } en la cabeza!
execution-popup-gun-complete-external = { $attacker } { $victim } dispara en la cabeza!
execution-popup-gun-clumsy-internal = ¡Fallas la cabeza { $victim } y te disparas en el pie!
execution-popup-gun-clumsy-external = { $attacker } falla el { $victim } y se dispara en la pierna.
execution-popup-gun-empty = { CAPITALIZE($weapon) } clics.
execution-popup-ammo-empty = El cartucho se agota.
suicide-popup-gun-initial-internal = Te pones el bozal { $weapon } la boca.
suicide-popup-gun-initial-external = { $attacker } se pone el barril { $weapon } la boca.
suicide-popup-gun-complete-internal = ¡Te estás disparando en la cabeza!
suicide-popup-gun-complete-external = { $attacker } se dispara en la cabeza!
suicide-popup-melee-complete-internal = ¡Te estás cortando la garganta!
suicide-popup-melee-complete-external = { $attacker } le está cortando la garganta.
suicide-popup-melee-initial-internal = Te pones { $weapon } en la garganta.
suicide-popup-melee-initial-external = { $attacker } se { $weapon } la garganta.
execution-popup-melee-initial-internal = Has puesto { $weapon } en la garganta de { $victim }.
execution-popup-melee-initial-external = { $attacker } pone { $weapon } contra la garganta del { $victim }.
execution-popup-melee-complete-internal = ¡Estás cortando la garganta { $victim }!
execution-popup-melee-complete-external = { $attacker } corta la garganta de { $victim }!
execution-popup-self-initial-internal = Te { $weapon } pones contra tu propia garganta.
execution-popup-self-initial-external = { $attacker } pone { $weapon } contra su garganta.
execution-popup-self-complete-internal = ¡Te estás cortando la garganta!
execution-popup-self-complete-external = { $attacker } le está cortando la garganta.
