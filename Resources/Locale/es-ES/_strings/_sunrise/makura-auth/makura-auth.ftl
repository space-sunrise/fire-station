makura-auth-gate-title = Makura Games ID
makura-auth-gate-subtitle = Se requiere autorización para iniciar sesión en el servidor
makura-auth-gate-body =
    Para jugar en nuestro servidor, necesitas añadir un correo electrónico o enlazar un servicio de terceros: Discord, Telegram o GitHub a través del ID de Makura Games.

    Ve a la página de registro, completa la configuración y haz clic en Revisar.
makura-auth-gate-url-placeholder = Aquí aparecerá un enlace para registrarse
makura-auth-gate-open-button = Página abierta
makura-auth-gate-check-button = Comprobado
makura-auth-gate-check-button-wait = Espera: { TOSTRING($time, "G3") }
makura-auth-gate-disconnect-button = Desconexión
makura-auth-gate-quit-button = Desconectarse

makura-auth-gate-not-configured = La puerta Makura no está configurada. Contacta con los administradores.
makura-auth-gate-unavailable = El ID de Makura Games no está disponible temporalmente. Por favor, inténtalo de nuevo más tarde.
makura-auth-gate-conflict = Abre la página de registro para más detalles.
makura-auth-gate-username-required = Se ha creado el ID de Makura Games, ¡pero no tienes acceso al juego! Sigue el enlace y introdúcelo para jugar en nuestros servidores.
makura-auth-gate-manual-reconnect-body =
    ¡El registro en Makura Games ID fue un éxito!

    Para continuar, tienes que volver a entrar en el servidor del juego.
makura-auth-gate-manual-reconnect-disconnect-reason = El registro para el ID de Makura Games fue exitoso. Reinicia sesión en el servidor del juego para continuar.
