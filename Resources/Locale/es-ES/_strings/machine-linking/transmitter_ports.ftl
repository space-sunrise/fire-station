signal-port-name-pressed = Prensado
signal-port-description-pressed = Este puerto se activa siempre que se activa el transmisor.
signal-port-name-on-transmitter = ON
signal-port-description-on-transmitter = Este puerto se activa cada vez que se enciende el transmisor.
signal-port-name-off-transmitter = FUERA
signal-port-description-off-transmitter = Este puerto se activa cada vez que el transmisor se apaga.
signal-port-name-status-transmitter = Estado
signal-port-description-status-transmitter = Este puerto se utiliza a un nivel alto o bajo, dependiendo del estado del transmisor.
signal-port-name-left = Izquierda
signal-port-description-left = Este puerto se activa siempre que la palanca se mueve a la posición más a la izquierda.
signal-port-name-right = A la derecha
signal-port-description-right = Este puerto se activa siempre que la palanca se mueve hacia el extremo derecho.
signal-port-name-doorstatus = Estado de la Puerta de Enlace
signal-port-description-doorstatus = Este puerto se utiliza a un nivel alto cuando se interactúa con el dispositivo, y a un nivel bajo cuando está cerrado.
signal-port-name-dockstatus = Estado del muelle
signal-port-description-dockstatus = Este puerto se utiliza a un nivel alto cuando el dispositivo está acoplado y a un nivel bajo cuando no está acoplado.
signal-port-name-middle = Medio
signal-port-description-middle = Este puerto se activa siempre que la palanca se mueve a la posición neutra.
signal-port-name-timer-trigger = Contador de disparo
signal-port-description-timer-trigger = Este puerto se activa cada vez que se activa el temporizador.
signal-port-name-timer-start = Temporizador de inicio
signal-port-description-timer-start = Este puerto se activa cada vez que comienza el temporizador.
signal-port-name-logic-output = Salida
signal-port-description-logic-output = Este puerto se utiliza a un nivel alto o bajo, dependiendo del modo.
signal-port-name-logic-output-high = Alto nivel
signal-port-description-logic-output-high = Este puerto se activa siempre que el nivel de entrada es alto.
signal-port-name-logic-output-low = Bajo nivel
signal-port-description-logic-output-low = Este puerto se activa siempre que el nivel de entrada es bajo.
signal-port-name-air-danger = Peligro
signal-port-description-air-danger = Este puerto se activa con una señal de alta intensidad cuando el estado es Peligro; si el estado es diferente, entonces con un nivel bajo.
signal-port-name-air-warning = ADVERTENCIA
signal-port-description-air-warning = Este puerto se activa con una señal alta cuando el estado es Advertencia; si el estado es diferente, entonces con un nivel bajo.
signal-port-name-air-normal = Normal
signal-port-description-air-normal = Este puerto se utiliza con una señal de alta intensidad cuando el estado es Normal; si el estado es diferente, entonces con un nivel bajo.
signal-port-name-decaying = Desintegración
signal-port-description-decaying = Este puerto se activa cuando la anomalía unida entra en estado de decaimiento.
signal-port-name-stabilize = Estabilización
signal-port-description-stabilize = Este puerto se activa cuando la anomalía unida entra en un estado estable.
signal-port-name-growing = Crecimiento
signal-port-description-growing = Este puerto se activa cuando la anomalía unida entra en un estado de crecimiento.
signal-port-name-pulse = Impulso
signal-port-description-pulse = Este puerto se activa cuando una anomalía ligada crea un pulso.
signal-port-name-supercrit = Supercrítico
signal-port-description-supercrit = Este puerto se activa cuando una anomalía ligada explota tras entrar en un estado supercrítico.
signal-port-name-power-charging = Carga
signal-port-description-power-charging = Este puerto se activa con una señal de alta intensidad cuando la batería está cargando, y con una señal baja cuando no lo está.
signal-port-name-power-discharging = Descarga
signal-port-description-power-discharging = Este puerto se activa con una alta intensidad de señal cuando la batería está baja, y con baja intensidad cuando no lo está.
