suicide-command-description = Se suicida
suicide-command-help-text =
    El comando suicida te permite salir rápidamente de la ronda mientras permaneces en forma de personaje.
    Hay diferentes formas, primero intentarás usar un objeto en tu mano activa.
    Si esto falla, se intentará usar el objeto cerca de ti.
    Por último, si ninguno de los métodos anteriores funcionaba, morirás mordiéndote la lengua.
suicide-command-default-text-others = { $name } intenta morderse la lengua.
suicide-command-default-text-self = ¡Estás intentando morderte la lengua!
suicide-command-already-dead = No puedes suicidarte. Estás muerto.
suicide-command-no-mind = ¡No tienes mente!
suicide-command-denied = No puedes suicidarte en este momento.
