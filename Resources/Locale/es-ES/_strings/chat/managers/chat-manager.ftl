chat-manager-sender-announcement-wrap-message = [font size=14][bold]Announcement { $sender }:[/font][font size=12]
    { $message }[/bold][/font]
chat-manager-entity-say-wrap-message = [BubbleHeader][bold][Name]{ $entityName }[/Name][/bold][/BubbleHeader] { $verb }, [font={ $fontType } size={ $fontSize } ]«[BubbleContent]{ $message }[/BubbleContent]»[/font]
chat-manager-entity-say-bold-wrap-message = [BubbleHeader][bold][Name]{ $entityName }[/Name][/bold][/BubbleHeader] { $verb }, [font={ $fontType } size={ $fontSize } ]«[BubbleContent][bold]{ $message }[/bold][/BubbleContent]»[/font]
chat-manager-entity-whisper-wrap-message = [font size=11][italic][EncabezadoBurbuja][Nombre]{ $entityName }[/Nombre][/EncabezadoDeburbuja] susurra, "[ContenidoDeBomba]{ $message }[/ContenidoDeBomba]"[/italic][/font]
chat-manager-entity-whisper-unknown-wrap-message = [font size=11][italic][EncabezadoBomba]Alguien[/EncabezadoAguaAgua] susurra: "[Contenido de Burbuja]{ $message }[/ContenidoDeBomba]"[/italic][/font]
chat-manager-entity-me-wrap-message = [italic]{ $entityName } { $message }[/italic]
chat-manager-entity-looc-wrap-message = LOOC: [bold]{ $entityName }:[/bold] { $message }
chat-manager-send-ooc-wrap-message = OOC: [bold]{ $playerName }:[/bold] { $message }
chat-manager-send-ooc-sponsor-wrap-message = OOC: [bold][color={ $sponsorColor }]{ $playerName }[/color]:[/bold] { $message }
