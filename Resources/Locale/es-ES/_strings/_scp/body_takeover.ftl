body-takeover-poll-window-title = Entidad disponible
body-takeover-poll-window-body = OOC: Necesitas un jugador para { $entity }. ¿Quieres tomar el control?
body-takeover-poll-window-accept = si
body-takeover-poll-window-decline = No

body-takeover-transfer-window-title = Asignación de Entidades
body-takeover-transfer-window-body = OOC: Has sido elegido para el papel de { $entity }. Tienes { $delay } antes del traslado automático.
body-takeover-transfer-window-now = Transfiere ahora
body-takeover-transfer-window-wait = espera
body-takeover-transfer-window-decline = Rechazar

body-takeover-delay-minutes = { $count ->
    [one] { $count } minuto
    [few] { $count } minutos
    *[other] { $count } minutos
}
body-takeover-delay-seconds = { $count ->
    [one] { $count } segundo
    [few] { $count } segundos
    *[other] { $count } segundos
}
