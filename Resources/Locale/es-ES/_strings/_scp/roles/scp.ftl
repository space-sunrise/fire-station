job-name-scp049 = SCP-049 "Doctor de la Peste"
job-description-scp049 = Un humanoide misterioso con túnica que se considera médico. Su toque es mortal, y el objetivo es "curar" a la humanidad.
job-name-scp082 = SCP-082 "Caníbal Fernand"
job-description-scp082 = Un gigante con modales refinados y gusto por la carne humana. Le encanta contar historias antes de dar un banquete.
job-name-scp096 = SCP-096 "Modesto"
job-description-scp096 = Una criatura extremadamente peligrosa que reacciona a la mirada. Si alguien ve su rostro, nada salvará a la víctima.
job-name-scp106 = SCP-106 "Viejo"
job-description-scp106 = Un viejo monstruo podrido que emerge de portales corrosivos. Cazando a las víctimas con crueldad sádica.
job-name-scp173 = SCP-173 "Escultura"
job-description-scp173 = Una escultura que mata cuando pierdes el contacto visual. Rápida, silenciosa y letal si parpadeas.
job-name-scp247 = SCP-247 "Gatito Inofensivo"
job-description-scp247 = Una criatura depredadora y astuta, que parece un gato, pero en realidad un tigre.
job-name-scp457 = SCP-457 "Hombre Ardiente"
job-description-scp457 = Una persona que está constantemente ardiente y necesita combustible para mantenerse en forma.
job-name-scp939 = SCP-939 "Con muchas voces"
job-description-scp939 = Criaturas depredadoras sin ojos, atrayendo víctimas con las voces de víctimas anteriores. Ideal para ataques sigilosos en la oscuridad.
job-name-scp999 = SCP-999 "Monstruo Cosquilleo"
job-description-scp999 = Una entidad amigable y gelatinosa que evoca una alegría y risas infinitas. Capaz de aliviar el estrés y tratar la depresión.
job-name-scp3288-alpha = SCP-3288-Alfa "Aristócratas"
job-description-scp3288-alpha = Un gigante lujoso con harapos de la antigua gloria de los Habsburgo. Arrogante, cruel y dispuesto a devorar a cualquiera que considere un "ser inferior".

job-name-scp0192 = SCP-019-2 "Jarrón Monstruoso"
job-description-scp0192 = Una entidad extremadamente agresiva que emerge de SCP-019.
job-name-scp131 = SCP-131 "Blobeye"
job-description-scp131 = Pequeñas criaturas mecánicas inofensivas con un ojo grande y prominente.
job-name-scp1508 = SCP-1508 "Camisetas de tirantes, amigo de la limpieza"
job-description-scp1508 = Un amigo fiel de cartón que intenta ayudar a la gente.
job-name-scp1589 = SCP-1589 "Gólem romano antiguo"
job-description-scp1589 = Un gigante obediente y tranquilo que obedece cualquier orden.
job-name-scp2295 = SCP-2295 "Oso de Corazón Harapo"
job-description-scp2295 = Un oso de trapo amigable que cura a la gente.
job-name-scp3288 = SCP-3288 "Aristócratas"
job-description-scp3288-servant = El individuo más humilde del reino, obligado a obedecer a los amos. Organizar banquetes y bailes, cocinar carne humana y entretener a los aristócratas.
job-description-scp3288-knight = Defensor de la dinastía de los Habsburgo. Patrullar el territorio, proteger a los sangre pura y destruir sin piedad a los forasteros.
job-description-scp3288-aristocrat = Un mutante influyente con tendencias sádicas. Devora carne humana, da órdenes a tus sirvientes y diviértete.
