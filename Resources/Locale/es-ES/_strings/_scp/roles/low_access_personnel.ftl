job-name-class-d = Clase D
job-description-class-d = Clase D - Personal prescindible usado para "trabajos menores" que son demasiado peligrosos para otro personal. Un ejemplo de un "mal necesario" en la Fundación.
job-name-class-d-cook = Chef de Clase D
job-description-class-d-cook = Clase D: Lo único que le diferencia de los demás es el acceso a la cocina y la obligación de cocinar para toda la Unidad D.
job-name-class-d-botanist = Botánico de clase D
job-description-class-d-botanist = Clase D: Lo único que le diferencia de los demás es su acceso a la botánica y el deber de suministrar comida al cocinero del Bloque D.
job-name-class-d-janitor = Limpiador Clase D
job-description-class-d-janitor = Clase D: Lo único que le diferencia de los demás es el acceso a equipos de limpieza y la responsabilidad de mantener el Bloque D ordenado.

